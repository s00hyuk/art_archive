# Secrets — never commit
.env
.env.local
*.key
kaggle.json

# Raw Kaggle dataset — too large for GitHub (use scripts/download_kaggle.py locally)
data/raw/
data/best-artworks/

# Generated outputs (uncomment to commit curations as eval set)
# outputs/curations/

# Track B (Baseline vs ABS) pipeline outputs — regenerated by `python -m src.pipeline`
output/descriptions/*.json
output/audio/*.mp3
output/eval_results.csv
output/sample_index.csv
!output/descriptions/.gitkeep
!output/audio/.gitkeep
data/ground_truth/*.txt
!data/ground_truth/.gitkeep
!data/ground_truth/README.md

