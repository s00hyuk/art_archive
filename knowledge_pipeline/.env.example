# Copy to .env on the MAIN PC only. NEVER commit .env.

# --- Notion ---
# Internal integration token (https://www.notion.so/my-integrations).
# Share the integration with the 4 "Personal Knowledge OS" databases.
NOTION_TOKEN=secret_...

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Pipeline behavior ---
# 이 신뢰도 이상이면 사람 검토 없이 바로 '완료' 처리 (0~1).
CONFIDENCE_AUTO_DONE=0.8
# 처리기 식별자(멀티 PC 확장 대비). 아무 문자열이나.
WORKER_ID=main-pc
# 처리 규칙 버전. 규칙이 바뀌면 올리세요 → 과거 자료 재처리 식별.
PROCESSING_VERSION=v1
# '민감' 등급 자료도 LLM으로 보낼지 (기본 false → 검토로만 남김).
PROCESS_SENSITIVE=false
