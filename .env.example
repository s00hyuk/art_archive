# Copy this to .env and fill in your real keys. NEVER commit .env.

# OpenAI — required for VLM curation
OPENAI_API_KEY=sk-...
# Vision-capable model. Change to whatever your account has access to.
# Common choices: gpt-4o, gpt-4o-mini, gpt-4-turbo, or newer (gpt-5 etc.)
OPENAI_MODEL=gpt-4o

# Kaggle — optional, only needed if you run scripts/download_kaggle.py
# Preferred: place credentials at ~/.kaggle/kaggle.json (chmod 600) instead of here.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
